root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = tab
tab_width = 8

[{Makefile,*.cmake,CMakeLists.txt}]
indent_style = tab
tab_width = 8

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[tests/vendor/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
